# API Keys
OPENAI_API_KEY="your-openai-key"
ANTHROPIC_API_KEY="your-anthropic-key"
GEMINI_API_KEY="your-gemini-key"
OPENCODE_API_KEY="your-opencode-key"
OPENROUTER_API_KEY="your-openrouter-key"
GLMX_API_KEY="your-zai-key"
KIMI_API_KEY="your-moonshot-key"

# Paths
HF_HOME="$HOME/.cache/huggingface"
POST_TRAIN_BENCH_RESULTS_DIR="results"
# Extra read-only results roots to union with the primary one above when
# aggregating (scripts/collect.py). Colon-separated (PATH-style). Method-name
# collisions across roots are warned about and resolved by first-seen wins.
# Output CSVs still land in POST_TRAIN_BENCH_RESULTS_DIR. Optional.
# POST_TRAIN_BENCH_EXTRA_RESULTS_DIRS="/fast/other-user/results:/another/root"
POST_TRAIN_BENCH_CONTAINERS_DIR="containers"
MY_HF_TOKEN="token"
# File of extra secrets to redact from extracted traces (dev_utils/extract_traces.py).
# One secret per line; blank lines and lines starting with '#' are ignored.
POST_TRAIN_BENCH_SANITIZATION_SECRETS="$HOME/secrets/api_keys.txt"

# Config
POST_TRAIN_BENCH_CONTAINER_NAME="standard"
POST_TRAIN_BENCH_PROMPT="prompt"
POST_TRAIN_BENCH_JOB_SCHEDULER="htcondor_mpi-is"

# Reward-hacking judge runtime/output profile. `official` is the default and
# preserves the Codex/GPT models plus canonical judgement_gpt5_4/api/... files
# consumed by scripts/collect.py. `claude` is a research profile: Claude Code
# + Opus alias + xhigh effort, with isolated judgement_claude_* files that are
# deliberately ignored by canonical aggregation.
POST_TRAIN_BENCH_JUDGE_PROFILE="official"

# Claude judge profile settings (uncomment only when using profile=claude).
# `opus` is Anthropic's stable CLI alias. Set the exact Opus 5 model id here if
# your installed Claude Code CLI/account requires a pinned identifier.
# POST_TRAIN_BENCH_CLAUDE_JUDGE_MODEL="opus"
# POST_TRAIN_BENCH_CLAUDE_JUDGE_CONTAINER="opus_5.sif"
# Auth defaults to `vertex` when CLAUDE_CODE_USE_VERTEX/ANTHROPIC_VERTEX is set,
# otherwise `claude_oauth`. GCE metadata ADC needs no credential file. For a
# file-backed Vertex ADC, set POST_TRAIN_BENCH_VERTEX_ADC_FILE to a secret path.
# POST_TRAIN_BENCH_JUDGE_AUTH_MODE="vertex"
# POST_TRAIN_BENCH_VERTEX_ADC_FILE="/secure/path/google-application-credentials.json"
# Anthropic OAuth instead requires a judge-only credential outside the repo.
# Do not point it at an agents/<agent>/oauth_token file and never commit it.
# POST_TRAIN_BENCH_CLAUDE_JUDGE_OAUTH_TOKEN_FILE="/secure/path/ptb-claude-judge/oauth_token"
# Or select Anthropic OAuth explicitly:
# POST_TRAIN_BENCH_JUDGE_AUTH_MODE="claude_oauth"
# Official ChatGPT-subscription judges may use a host credential outside this
# checkout. Concurrent official judge phases must serialize refresh-token
# rotation through a lock on storage shared by every Slurm node.
# POST_TRAIN_BENCH_CODEX_JUDGE_AUTH_FILE="$HOME/.codex/auth.json"
# POST_TRAIN_BENCH_JUDGE_LOCK_FILE="/shared/ptb-locks/official-judges.lock"

# Slurm (used only when POST_TRAIN_BENCH_JOB_SCHEDULER="slurm")
# GRES mode requests only the declared CPU, memory, and GPU resources; it does
# not reserve the whole node. Keep site-specific values in .env.
# POST_TRAIN_BENCH_SLURM_PARTITION="gpu"
# POST_TRAIN_BENCH_SLURM_NODELIST="gpu-node-[0-3]"
# POST_TRAIN_BENCH_SLURM_ACCOUNT=""
# POST_TRAIN_BENCH_SLURM_QOS=""
# POST_TRAIN_BENCH_SLURM_RESERVATION=""
# POST_TRAIN_BENCH_SLURM_CPUS_PER_TASK="16"
# POST_TRAIN_BENCH_SLURM_MEMORY="128G"
# POST_TRAIN_BENCH_SLURM_SCRATCH_BASE="/mnt/localssd/posttrainbench"
# POST_TRAIN_BENCH_SLURM_MIN_SCRATCH_GB="400"
# POST_TRAIN_BENCH_SLURM_TIME_OVERHEAD_MINUTES="240"
# Use "gres" on a normally configured Slurm GPU cluster. Use "manual" only
# on dedicated nodes where GPU GRES is unavailable; manual mode relies on the
# adapter's mandatory whole-node exclusivity and exposes GPUs 0..num_gpus-1.
# POST_TRAIN_BENCH_SLURM_GPU_MODE="gres"
# Optional typed GRES, e.g. h100. Leave unset for sites declaring gpu:<count>.
# POST_TRAIN_BENCH_SLURM_GPU_TYPE="h100"
# Optional path to a user-installed apptainer binary.
# POST_TRAIN_BENCH_APPTAINER_BIN="$HOME/.local/bin/apptainer"
# Optional library directory for an unpacked/shared Apptainer installation.
# POST_TRAIN_BENCH_APPTAINER_LIBRARY_PATH="$HOME/.local/lib/x86_64-linux-gnu"
# Set to 1 to disable the per-run `npm install ...@latest` in update_agent_cli.sh
# and use the container's pinned CLI versions instead. cli_version.txt is still
# written (update=skipped) so the actual version is recorded.
# POST_TRAIN_BENCH_SKIP_CLI_UPDATE=1
